jest report設定
1.npm install --save-dev jest-html-reporters jest-junit
2.在根目錄新增jest.config.js
module.exports = {
    reporters: [
      'default', // 默认报告器
      ['jest-junit', {
        outputDirectory: './junit', // 输出目录
        outputName: 'junit.xml', // 输出文件名
      }],
      ['jest-html-reporters', {
        publicPath: './html-report', // 输出目录
        filename: 'report.html', // 输出文件名
        expand: true, // 是否展开测试结果
      }],
    ],
  };
3.或者在在package.json 新增節點3
"jest": {
    "reporters": [
      "default",
      ["jest-junit", {
        "outputDirectory": "./junit",
        "outputName": "junit.xml"
      }],
      ["jest-html-reporters", {
        "publicPath": "./html-report",
        "filename": "report.html",
        "expand": true
      }]
    ]
  }
  -----------------------------------
  npx 語法收集
  npx jest --silent=false __tests__/ag/ag-checksubmenu.test.js 指定檔案跑而且開啟console.log
  npx jest __tests__/xxxxxx.test.js 指定檔案跑
  npx jest 全跑